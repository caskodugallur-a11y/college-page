# ── Firebase runtime logs (never commit these) ──
firebase-debug.log
firebase-debug.*.log
.firebase/
firestore-debug.log
ui-debug.log

# ── Environment & secrets (never commit these) ──
.env
.env.*
*.env

# ── Service account & private credentials (never commit these) ──
*service-account*.json
*serviceAccount*.json
*-adminsdk-*.json
*private-key*.json
*.pem
*.key

# ── Node (if npm is ever used locally) ──
node_modules/
npm-debug.log*
yarn-error.log

# ── OS / IDE junk files ──
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

# ── NOTE: firebase-config.js is intentionally NOT excluded.
# Firebase client-side API keys are PUBLIC by design.
# Security is enforced by Firebase Security Rules, not by hiding these keys.
# See: https://firebase.google.com/docs/projects/api-keys
